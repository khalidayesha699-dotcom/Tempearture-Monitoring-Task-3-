# Temperature limits
MIN_TEMP = 19
MAX_TEMP = 23

# Read temperature deviation Excel file data
df = pd.read_excel("room 02-3333.xlsx")

# Find the Room Temp column
room_temp_column = [col for col in df.columns if "Room Temp" in col][0]

# Create results table
results = df[["Timestamp", room_temp_column]]

# High temperature Variation
high_temps = results[results[room_temp_column] > MAX_TEMP]

# Low temperature Variation
low_temps = results[results[room_temp_column] < MIN_TEMP]

print("\nHIGH TEMPERATURE Variation")
print(high_temps)

print("\nLOW TEMPERATURE Variation")
print(low_temps)

print("\nVariation_Results")
print(f"High Variation: {len(high_temps)}")
print(f"Low Variation: {len(low_temps)}")
# Combine and save all variations
variation = pd.concat([high_temps, low_temps])

variation.to_excel(
    "Temperature_Variation_Report.xlsx",
    index=False
)

print("\nReport created:")
print("Temperature_Variation_Report.xlsx")
import matplotlib.pyplot as plt

# Create graph
plt.figure(figsize=(12,6))

plt.plot(
    results["Timestamp"],
    results[room_temp_column],
    label="Room Temperature"
)

plt.axhline(
    y=MAX_TEMP,
    color="red",
    linestyle="--",
    label="Maximum Limit"
)

plt.axhline(
    y=MIN_TEMP,
    color="blue",
    linestyle="--",
    label="Minimum Limit"
)

plt.title("Room Temperature Trend")
plt.xlabel("Date")
plt.ylabel("Temperature (°C)")
plt.legend()

plt.savefig("temperature_graph.png")

print("Graph created: temperature_graph.png")
