#import pandas as pd

# Temperature limits
MIN_TEMP = 20
MAX_TEMP = 24

# Read Excel file
df = pd.read_excel("room 02-3333.xlsx")

# Find the Room Temp column
room_temp_column = [col for col in df.columns if "Room Temp" in col][0]

# Create results table
results = df[["Timestamp", room_temp_column]]

# High temperature breaches
high_temps = results[results[room_temp_column] > MAX_TEMP]

# Low temperature breaches
low_temps = results[results[room_temp_column] < MIN_TEMP]

print("\nHIGH TEMPERATURE BREACHES")
print(high_temps)

print("\nLOW TEMPERATURE BREACHES")
print(low_temps)

print("\nSUMMARY")
print(f"High breaches: {len(high_temps)}")
print(f"Low breaches: {len(low_temps)}")
breaches = pd.concat([high_temps, low_temps])

breaches.to_excel(
    "Temperature_Breach_Report.xlsx",
    index=False
)

print("\nReport created:")
print("Temperature_Breach_Report.xlsx")
import matplotlib.pyplot as plt

# Create graph
plt.figure(figsize=(12,6))

plt.plot(
    results["Timestamp"],
    results[room_temp_column],
    label="Room Temperature"
)

plt.axhline(
    y=MAX_TEMP,
    color="red",
    linestyle="--",
    label="Maximum Limit"
)

plt.axhline(
    y=MIN_TEMP,
    color="blue",
    linestyle="--",
    label="Minimum Limit"
)

plt.title("Room Temperature Trend")
plt.xlabel("Date")
plt.ylabel("Temperature (°C)")
plt.legend()

plt.savefig("temperature_graph.png")

print("Graph created: temperature_graph.png")
